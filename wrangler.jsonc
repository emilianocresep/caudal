// Configuración del Worker de Caudal en Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caudal",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "caudal-db" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "morning-wave-5908.cloudflareaccess.com",
    "ACCESS_AUD": "PEGA_AQUI_TU_AUD_COMPLETO",
    "ALLOWED_EMAIL": "carmee1029@gmail.com"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
