// Configuración del Worker de Caudal en Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caudal", // debe coincidir con el nombre de tu Worker en Cloudflare
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // La base de datos se crea sola en el primer despliegue (o se conecta si ya existe con este nombre).
  "d1_databases": [{ "binding": "DB", "database_name": "caudal-db" }],
  "vars": {
    // Clave opcional: escribe una aquí (por ejemplo "tacos-azules-2026") y la app te la pedirá
    // una sola vez en cada dispositivo. Déjala vacía ("") para usar la app sin ninguna clave.
    "APP_KEY": "gABRIELA1029"
  },
  // Conserva las variables que pongas en el panel de Cloudflare.
  "keep_vars": true,
  "observability": { "enabled": true }
}
